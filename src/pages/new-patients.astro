---
import Base from '../layouts/Base.astro';
import { practice, bookingHref, bookingLabel } from '../data/practice.js';
---
<Base title="New Patients Welcome" description="New patients are welcome at 1 Oak Dental in downtown Toronto. What to expect, insurance, CDCP and payment options.">
  <div class="wrap">
    <div class="hero">
      <h1>New patients welcome</h1>
      <p class="lead">Whether you need a cleaning or a full smile makeover, here is what to expect.</p>
    </div>
    <section>
      <h2>Your first visit</h2>
      <p>We review your health history, examine your teeth and gums, take any X-rays you need, and talk through what we find. If you came for a specific treatment, you leave with a written plan and estimate.</p>
    </section>
    <section>
      <h2>Insurance, CDCP and payment</h2>
      <p>We bill most dental insurance directly and accept patients covered by the Canadian Dental Care Plan. We take major credit cards, debit and cash.{practice.payments.financing && ` Monthly financing for larger treatment is available through ${practice.payments.financing}.`}</p>
    </section>
    <section>
      <h2>Nervous about the dentist?</h2>
      <p>Tell us. Sedation is available for many procedures, and we will go at your pace.</p>
    </section>
    <section>
      <h2>Referred by a friend?</h2>
      <p>Referrals are the best compliment we can get. Mention who sent you when you book.</p>
      <div class="actions">
        <a class="btn" href={bookingHref}>{bookingLabel}</a>
        <a class="btn secondary" href={`tel:${practice.phoneE164}`}>Call {practice.phone}</a>
      </div>
    </section>
  </div>
</Base>
