---
import Base from '../layouts/Base.astro';
import { practice, services } from '../data/practice.js';
---
<Base
  title="1 Oak Dental | Dentist in Regent Park, Downtown Toronto"
  description="1 Oak Dental is a family and implant dental office at 1 Oak St in Regent Park, downtown Toronto. Implants, wisdom teeth, Invisalign and emergency care. Free consultations."
>
  <div class="wrap">
    <div class="hero">
      <h1>Your dentist in Regent Park, downtown Toronto</h1>
      <p class="lead">
        1 Oak Dental cares for families and individuals at 1 Oak St. Dr. Ammar Taimish focuses on dental implants,
        full-arch implants and oral surgery, and our team handles everything from checkups to emergencies.
      </p>
      <div class="actions">
        <a class="btn" href="/contact/">Book a free consultation</a>
        <a class="btn secondary" href={`tel:${practice.phoneE164}`}>Call {practice.phone}</a>
      </div>
    </div>

    <section>
      <h2>What we do</h2>
      <div class="grid">
        {services.map((s) => (
          <a class="card" href={`/services/${s.slug}/`} style="text-decoration:none;color:inherit">
            <h3>{s.title}</h3>
            <p class="muted">{s.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2>Why patients choose us</h2>
      <div class="grid">
        <div class="card"><h3>Implant and surgery focus</h3><p>Dr. Taimish limits his practice to oral surgery and implant dentistry, and teaches implant courses to other dentists.</p></div>
        <div class="card"><h3>Free consultation</h3><p>Meet the dentist, get your questions answered and leave with a written plan and estimate.</p></div>
        <div class="card"><h3>Insurance, CDCP and financing</h3><p>We bill most insurance directly, accept the Canadian Dental Care Plan, and offer monthly payment plans.</p></div>
      </div>
    </section>

    <section>
      <h2>Find us</h2>
      <p>{practice.street}, {practice.city}, {practice.region} {practice.postalCode}. In {practice.neighbourhood}.</p>
      <a class="btn secondary" href={practice.mapsUrl}>Get directions</a>
    </section>
  </div>
</Base>
