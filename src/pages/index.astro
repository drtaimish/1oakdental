---
import Base from '../layouts/Base.astro';
import { practice, services } from '../data/practice.js';
---
<Base
  title="1 Oak Dental | Family Dentist in Regent Park, Downtown Toronto"
  description="1 Oak Dental is a full-service family dentist at 1 Oak St in Regent Park, downtown Toronto. Checkups, kids, emergencies, Invisalign and implants. CDCP and insurance accepted."
>
  <div class="wrap">
    <div class="hero">
      <h1>Your family dentist in Regent Park, downtown Toronto</h1>
      <p class="lead">
        Checkups and cleanings for the whole family, gentle care for kids, fast help for emergencies, and
        advanced treatment like implants under one roof at 1 Oak St.
      </p>
      <div class="actions">
        <a class="btn" href="/contact/">Book an appointment</a>
        <a class="btn secondary" href={`tel:${practice.phoneE164}`}>Call {practice.phone}</a>
      </div>
    </div>

    <section>
      <h2>Care for every age</h2>
      <div class="grid">
        {services.map((s) => (
          <a class="card" href={`/services/${s.slug}/`} style="text-decoration:none;color:inherit">
            <h3>{s.title}</h3>
            <p class="muted">{s.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2>Why families choose us</h2>
      <div class="grid">
        <div class="card"><h3>New patients welcome</h3><p>Adults, teens and kids. Tell us if you are nervous and we will go at your pace.</p></div>
        <div class="card"><h3>Insurance and CDCP</h3><p>We bill most insurance directly and accept the Canadian Dental Care Plan. Monthly payment plans for larger treatment.</p></div>
        <div class="card"><h3>Specialist-level surgery in-house</h3><p>Dr. Taimish focuses on implants and oral surgery, so wisdom teeth and implants rarely mean a trip somewhere else.</p></div>
      </div>
    </section>

    <section>
      <h2>Find us</h2>
      <p>{practice.street}, {practice.city}, {practice.region} {practice.postalCode}. In {practice.neighbourhood}.</p>
      <a class="btn secondary" href={practice.mapsUrl}>Get directions</a>
    </section>

    <section class="card">
      <h2>Are you a dentist?</h2>
      <p>We accept referrals for implants, full-arch cases, wisdom teeth and surgical extractions, and send your patient back to you with a full report.</p>
      <a class="btn secondary" href="/referrals/">Refer a patient</a>
    </section>
  </div>
</Base>
