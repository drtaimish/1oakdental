---
import Base from '../layouts/Base.astro';
import { practice, referralGroups, team } from '../data/practice.js';
const patientLinks = [
  ['Family and general dentistry', '/services/general-dentistry/'],
  ['Sleep dentistry', '/services/sleep-dentistry/'],
  ['Invisalign clear aligners', '/services/invisalign/'],
  ['Tooth extractions', '/services/tooth-extractions/'],
  ['Dental implants', '/services/dental-implants/'],
];
---
<Base
  title="1 Oak Dental | Family Dentist in Downtown Toronto"
  description="1 Oak Dental at 1 Oak St, downtown Toronto: family and general dentistry, sleep dentistry, Invisalign, extractions and implants. Referring dentists welcome."
>
  <div class="wrap">
    <div class="hero">
      <p class="eyebrow">Downtown Toronto · 1 Oak St</p>
      <h1>Family dentist in downtown Toronto. A referral partner for your practice.</h1>
      <p class="lead">Explore family dentistry, sleep dentistry and surgical care at {practice.name}.</p>
      <div class="actions">
        <a class="btn" href="/patients/">I'm a patient</a>
        <a class="btn secondary" href="/referring-dentists/">I'm referring a patient</a>
      </div>
    </div>

    <section class="panels" aria-label="Choose your path">
      <div class="panel patients">
        <h2>Explore your care options</h2>
        <ul>
          {patientLinks.map(([t, h]) => <li><a href={h}>{t}</a></li>)}
        </ul>
        <a class="btn" href="/contact/">Request an appointment</a>
      </div>
      <div class="panel dentists">
        <h2>Refer to {practice.name}</h2>
        <ul>
          {referralGroups.map((g) => <li><a href={`/referring-dentists/#${g.id}`}>{g.title}</a></li>)}
        </ul>
        <a class="btn" style="background:#fff;color:var(--brand)" href="/referring-dentists/#refer">Start a referral</a>
      </div>
    </section>

    <section>
      <h2>Our dentists</h2>
      <div class="grid">
        {team.map((t) => (
          <div class="card"><h3 style="margin:0">{t.name}</h3><p class="muted" style="margin:4px 0 8px">{t.role}</p><p style="margin:0">{t.blurb}</p></div>
        ))}
      </div>
    </section>

    <section>
      <h2>Find us</h2>
      <p>{practice.street}, {practice.city}, {practice.region} {practice.postalCode}. In {practice.neighbourhood}.</p>
      <div class="actions">
        <a class="btn secondary" href={practice.mapsUrl}>Get directions</a>
        <a class="btn secondary" href={`tel:${practice.phoneE164}`}>Call {practice.phone}</a>
      </div>
    </section>
  </div>
</Base>
