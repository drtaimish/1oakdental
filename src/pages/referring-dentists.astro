---
import Base from '../layouts/Base.astro';
import { practice, referralGroups, team, sedationOptions } from '../data/practice.js';
---
<Base title="Referring Dentists: Oral Surgery, Implants, Sedation" description="Refer oral surgery, implant, pediatric and sleep dentistry cases to 1 Oak Dental in downtown Toronto. IV sedation, deep sedation and general anaesthesia in office. New referrals seen within a few days.">
  <div class="wrap">
    <div class="hero" style="padding-bottom:24px">
      <p class="eyebrow">For referring dentists</p>
      <h1>Refer a patient to {practice.name}</h1>
      <p class="lead">New referrals are seen within a few days. Your patient returns to you with a written report.</p>
      <div class="actions">
        <a class="btn" href="#refer">Start a referral</a>
        <a class="btn secondary" href={`tel:${practice.urgentPhoneE164}`}>Urgent cases: {practice.urgentPhone}</a>
      </div>
    </div>

    <section style="padding-top:0">
      <div class="grid">
        {team.map((t) => (
          <div class="card"><h3 style="margin:0">{t.name}</h3><p class="muted" style="margin:4px 0 0">{t.role}</p></div>
        ))}
      </div>
      <p class="muted">Dental implants · All-on-X · Extractions and impacted teeth · Orthodontic surgical exposure · IV sedation · Deep sedation · General anaesthesia · CBCT imaging</p>
    </section>

    <section class="how-ref">
      <h2>How referrals work</h2>
      <div class="grid">
        <div class="card">
          <h3>Turnaround</h3>
          <p>New referrals are seen within a few days. Mark a case urgent, or call {practice.urgentPhone}, and we see the patient the same or next business day. If you have not heard from us within two business days of sending a referral, call us; something went astray.</p>
        </div>
        <div class="card">
          <h3>Radiographs</h3>
          <p>Email recent PAs, a panoramic or CBCT to <a href={`mailto:${practice.email}`}>{practice.email}</a> as JPEG, PNG or DICOM, with the patient's name and date of birth in the subject line. If you have none, select "Please take" and we will image the patient here. <span class="muted">A secure upload link is coming; until then, please do not send images by text message.</span></p>
        </div>
        <div class="card">
          <h3>Reports back to you</h3>
          <p>You receive a written report after the consultation with the proposed plan, and again after treatment with what was done and the follow-up arranged. Reports go to the fax or email you give on the form.</p>
        </div>
        <div class="card">
          <h3>Your patient stays your patient</h3>
          <p>We treat what you refer and send the patient back to you for everything else, including implant restorations if you prefer to restore your own cases. We do not solicit referred patients for general care.</p>
        </div>
        <div class="card">
          <h3>Sedation for your patients</h3>
          <p>A physician anaesthesiologist provides IV sedation, deep sedation and general anaesthesia in our office. You can refer for sedation alone: your treatment plan, done here under anaesthesia, and the patient back to you afterwards.</p>
        </div>
        <div class="card">
          <h3>Learn with us</h3>
          <p>Dr. Taimish teaches implant surgery courses for dentists. Ask on the form or by email to hear about upcoming dates. <span class="muted">(Course page coming.)</span></p>
        </div>
      </div>
      <p class="muted" style="margin-top:12px">Please give the patient a copy of the referral and ask them to bring their insurance details and a medication list.</p>
    </section>

    <div class="ref-layout">
      <div class="directory">
        {referralGroups.map((g) => (
          <div id={g.id}>
            <h3>{g.title}</h3>
            <p class="muted" style="margin:0 0 8px">{g.provider}</p>
            <ul>
              {g.items.map((i) => (
                <li><a href={`?service=${i.id}#refer`} data-service={i.id}>{i.label}<span>Refer</span></a></li>
              ))}
            </ul>
          </div>
        ))}
        <div class="card">
          <h3 style="margin-top:0">Prefer the paper form?</h3>
          <p>Print a referral pad, fill it in and email it to <a href={`mailto:${practice.email}`}>{practice.email}</a>.</p>
          <div class="links" style="display:grid;gap:8px">
            <a href="/referral-pads/1-Oak-Dental-Referral-Pad.pdf">Oral surgery and implants referral pad (PDF)</a>
            <a href="/referral-pads/1-Oak-Dental-Pediatric-Sleep-Referral-Pad.pdf">Pediatric and sleep dentistry referral pad (PDF)</a>
          </div>
        </div>
      </div>

      <aside class="ref-form card" id="refer">
        <h2 style="font-size:1.6rem">Referral details</h2>
        <p class="preview-note">Online referrals are being set up. Until then, email your referral pad to <a href={`mailto:${practice.email}`}>{practice.email}</a> or call {practice.urgentPhone} for urgent cases.</p>
        <form class="consult" method="post" action="/api/referral">
          <fieldset style="border:0;padding:0;display:grid;gap:8px">
            <legend><strong>Referral type</strong> (select all that apply)</legend>
            {referralGroups.map((g) => (
              <div style="display:grid;gap:6px">
                <span class="muted" style="font-weight:600">{g.title}</span>
                {g.items.map((i) => (
                  <label class="check"><input type="checkbox" name="referral_type" value={i.label} data-id={i.id} /> {i.label}</label>
                ))}
              </div>
            ))}
            <label>Other <input name="referral_other" /></label>
          </fieldset>
          <label>Sedation / anaesthesia
            <select name="sedation">
              {sedationOptions.map((o) => <option>{o}</option>)}
            </select>
          </label>
          <label>Teeth involved (FDI) <input name="teeth" placeholder="e.g. 38, 48" /></label>
          <label>Radiographs
            <select name="radiographs">
              <option>Emailed</option>
              <option>Please take</option>
              <option>Given to patient</option>
            </select>
          </label>
          <label>Patient first name <input name="patient_first_name" required /></label>
          <label>Patient last name <input name="patient_last_name" required /></label>
          <label>Patient mobile <input name="patient_phone" type="tel" required /></label>
          <label>Date of birth <input name="patient_dob" type="date" /></label>
          <label>Insurance (if known) <input name="insurance" /></label>
          <label>Referring doctor <input name="referrer_name" required autocomplete="name" /></label>
          <label>Office <input name="referrer_clinic" required autocomplete="organization" /></label>
          <label>Phone <input name="referrer_phone" type="tel" required /></label>
          <label>Fax or email for the report <input name="referrer_email" required /></label>
          <label class="check"><input type="checkbox" name="urgent" value="yes" /> Urgent: please see within one business day</label>
          <label>Implant restoration
            <select name="restoration">
              <option>Not applicable</option>
              <option>Referring dentist will restore</option>
              <option>1 Oak Dental to restore</option>
            </select>
          </label>
          <label>Special instructions <textarea name="notes" rows="3"></textarea></label>
          <div class="hp" aria-hidden="true"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></div>
          <button class="btn" type="submit">Send referral</button>
        </form>
      </aside>
    </div>
  </div>
  <script is:inline>
    (function () {
      function pick(id) {
        var box = id && document.querySelector('input[data-id="' + id.replace(/[^a-z0-9-]/g, '') + '"]');
        if (box) { box.checked = true; return box; }
      }
      pick(new URLSearchParams(location.search).get('service'));
      document.querySelectorAll('[data-service]').forEach(function (a) {
        a.addEventListener('click', function (e) {
          e.preventDefault();
          var box = pick(a.dataset.service);
          document.getElementById('refer').scrollIntoView({ behavior: 'smooth' });
          if (box) box.focus({ preventScroll: true });
        });
      });
    })();
  </script>
</Base>
