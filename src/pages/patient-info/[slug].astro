---
import Base from '../../layouts/Base.astro';
import { practice } from '../../data/practice.js';
import { patientInfo } from '../../data/patientInfo.js';
export function getStaticPaths() {
  return patientInfo.map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}
const { page } = Astro.props;
const others = patientInfo.filter((p) => p.slug !== page.slug);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: practice.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Patient information', item: practice.url + '/patient-info/' },
    { '@type': 'ListItem', position: 3, name: page.title, item: `${practice.url}/patient-info/${page.slug}/` },
  ],
};
---
<Base title={page.title} description={`${page.summary} Instructions from 1 Oak Dental, downtown Toronto.`} schema={schema}>
  <div class="wrap prose">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/patient-info/">Patient information</a> › <span>{page.title}</span></nav>
    <div class="hero">
      <p class="eyebrow">Patient information</p>
      <h1>{page.title}</h1>
      <p class="lead">{page.summary} Questions at any time: call <a href={`tel:${practice.phoneE164}`}>{practice.phone}</a>.</p>
      <div class="actions"><button class="btn secondary" type="button" onclick="window.print()">Print this page</button></div>
    </div>
    {page.items.map(([h, p]) => (
      <section><h2>{h}</h2><p>{p}</p></section>
    ))}
    <p class="muted" style="font-size:.9rem">These are general instructions. The printed sheet you were given and anything your surgeon told you take priority.</p>
    <section>
      <h2>Other instructions</h2>
      <ul class="related">{others.map((o) => <li><a href={`/patient-info/${o.slug}/`}>{o.title}</a></li>)}</ul>
    </section>
  </div>
</Base>
