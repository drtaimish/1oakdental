---
import Base from '../layouts/Base.astro';
import { services, bookingHref, bookingLabel } from '../data/practice.js';
import ServiceArt from '../components/ServiceArt.astro';
---
<Base title="Dentist in Downtown Toronto for the Whole Family" description="Family dentistry, kids, sleep dentistry, Invisalign, extractions, implants and emergencies at 1 Oak Dental, downtown Toronto. Request an appointment online.">
  <div class="wrap">
    <div class="hero">
      <p class="eyebrow">For patients</p>
      <h1>How can we help you?</h1>
      <div class="actions"><a class="btn" href={bookingHref}>{bookingLabel}</a></div>
    </div>
    <div class="patient-grid">
      {services.map((s) => (
        <div class="card">
          <ServiceArt slug={s.slug} size={56} />
          <h2>{s.title}</h2>
          <p class="muted">{s.ask}</p>
          <div class="links">
            <a href={`/contact/?service=${s.slug}`}>Request a visit</a>
            <a href={`/services/${s.slug}/`}>Learn more</a>
          </div>
        </div>
      ))}
    </div>
    <section style="text-align:center;padding-top:56px">
      <h2>Tell us what brings you in.</h2>
      <a class="btn" href={bookingHref}>{bookingLabel}</a>
    </section>
  </div>
</Base>
