---
import Base from '../../layouts/Base.astro';
import { practice, services } from '../../data/practice.js';
import { articles } from '../../data/articles.js';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article: a } = Astro.props;
const related = services.filter((s) => a.related.includes(s.slug));
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: a.title,
      description: a.description,
      datePublished: a.date,
      dateModified: a.date,
      author: { '@type': 'Organization', name: practice.name, url: practice.url + '/' },
      publisher: { '@id': `${practice.url}/#dentist` },
      mainEntityOfPage: `${practice.url}/blog/${a.slug}/`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: practice.url + '/' },
        { '@type': 'ListItem', position: 2, name: 'Patient guides', item: practice.url + '/blog/' },
        { '@type': 'ListItem', position: 3, name: a.title, item: `${practice.url}/blog/${a.slug}/` },
      ],
    },
  ],
};
const dateText = new Date(a.date + 'T12:00:00').toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={a.title} description={a.description} schema={schema}>
  <article class="wrap prose">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/blog/">Patient guides</a> › <span>{a.title}</span></nav>
    <div class="hero">
      <p class="eyebrow">Patient guide · {dateText}{a.reviewedBy && ` · Reviewed by ${a.reviewedBy}`}</p>
      <h1>{a.title}</h1>
      <p class="lead">{a.intro}</p>
    </div>
    {a.sections.map(([h, p]) => (
      <section><h2>{h}</h2><p>{p}</p></section>
    ))}
    <p class="muted" style="font-size:.9rem">This guide is general information from {practice.name}, not personal advice. Your own instructions from your dentist or surgeon come first.</p>
    {related.length > 0 && (
      <section>
        <h2>Related care at {practice.name}</h2>
        <ul class="related">{related.map((r) => <li><a href={`/services/${r.slug}/`}>{r.title}</a></li>)}</ul>
      </section>
    )}
    <section class="card">
      <h2>Have a question about your own situation?</h2>
      <p>Call {practice.phone} or request an appointment. Your first consultation is free.</p>
      <a class="btn" href="/contact/">Request an appointment</a>
    </section>
  </article>
</Base>
