---
// Wordmark matching the storefront sign: "1 OAK", the tooth-implant mark, "DENTAL".
// The mark is redrawn from the sign: a heart-shaped crown outline, open at the neck,
// over a tapering stack of implant threads. Replace with the real vector logo when it arrives.
const { size = 28, class: cls = '' } = Astro.props;
---
<span class={`wordmark ${cls}`} style={`--wm: ${size}px`} aria-label="1 Oak Dental">
  <span class="wm-text">1 OAK</span>
  <svg class="wm-mark" viewBox="0 0 64 84" aria-hidden="true" focusable="false">
    <!-- crown: outer heart minus inner heart, inner shifted so the stroke is heavier top-right -->
    <path fill="currentColor" fill-rule="evenodd" d="
      M26 58 C18 50 5 41 5 25 C5 8 26 6 32 20 C38 6 59 8 59 25 C59 41 46 50 38 58 Z
      M29 52 C22 45 12 38 12 26 C12 15 26 14 32 26 C37 14 52 13 52 25 C52 37 41 45 35 52 Z" />
    <!-- implant threads -->
    <rect x="20" y="61" width="24" height="4.6" rx="2.3" fill="currentColor" />
    <rect x="22.5" y="67.5" width="19" height="4.4" rx="2.2" fill="currentColor" />
    <rect x="25" y="73.8" width="14" height="4.2" rx="2.1" fill="currentColor" />
    <rect x="27.5" y="79.8" width="9" height="3.8" rx="1.9" fill="currentColor" />
  </svg>
  <span class="wm-text">DENTAL</span>
</span>
