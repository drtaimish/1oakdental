---
import '../styles/global.css';
import { practice, bookingHref, bookingLabel } from '../data/practice.js';

interface Props {
  title: string;
  description: string;
  schema?: object;
}
const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, practice.url).href;
const fullTitle = title.includes(practice.name) ? title : `${title} | ${practice.name}, Toronto`;

const dentist = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  '@id': `${practice.url}/#dentist`,
  name: practice.name,
  legalName: practice.legalName,
  url: practice.url + '/',
  telephone: practice.phoneE164,
  address: {
    '@type': 'PostalAddress',
    streetAddress: practice.street,
    addressLocality: practice.city,
    addressRegion: practice.region,
    postalCode: practice.postalCode,
    addressCountry: 'CA',
  },
  areaServed: { '@type': 'City', name: 'Toronto' },
  sameAs: [practice.instagram, practice.linkedin, practice.googleProfileUrl].filter(Boolean),
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {Astro.url.pathname.startsWith("/thank-you") && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(dentist)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="logo" href="/">{practice.name}</a>
        <nav class="main" aria-label="Main">
          <a href="/patients/">For patients</a>
          <a href="/referring-dentists/">For referring dentists</a>
          <a href="/contact/">Contact</a>
        </nav>
        <a class="btn header-call" href={bookingHref}>{bookingLabel}</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap grid">
        <div>
          <strong>{practice.name}</strong><br />
          {practice.street}<br />
          {practice.city}, {practice.region} {practice.postalCode}<br />
          <a href={`tel:${practice.phoneE164}`}>{practice.phone}</a><br />
          <a href={practice.mapsUrl}>Get directions</a>
          {practice.googleProfileUrl && <><br /><a href={practice.googleProfileUrl} rel="noopener">Find us on Google</a></>}
        </div>
        <div>
          <strong>Services</strong><br />
          <a href="/services/general-dentistry/">Family dentistry</a><br />
          <a href="/services/sleep-dentistry/">Sleep dentistry</a><br />
          <a href="/services/childrens-dentistry/">Children's dentistry</a><br />
          <a href="/services/emergency-dentist/">Emergency care</a><br />
          <a href="/services/invisalign/">Invisalign</a><br />
          <a href="/services/dental-implants/">Dental implants</a><br />
          <a href="/services/tooth-extractions/">Extractions</a>
        </div>
        <div>
          <strong>Book or refer</strong><br />
          <a href={bookingHref}>{bookingLabel}</a><br />
          <a href="/referring-dentists/">Refer a patient</a><br /><br />
          <strong>Hours</strong><br />
          {practice.hours ? practice.hours : <span>Call us for today's hours.</span>}
        </div>
      </div>
      <div class="wrap"><p class="muted">© {new Date().getFullYear()} {practice.legalName}</p></div>
    </footer>
    <a class="btn sticky-call" href={`tel:${practice.phoneE164}`}>Call {practice.phone}</a>
  </body>
</html>
